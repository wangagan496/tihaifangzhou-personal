# Node.js 24. Defaults bind only to this computer. Never commit your .env.
HOST=127.0.0.1
PORT=3000
# Generate a random >=32-character code; enter it in the app at runtime.
# This is your private service access code, NOT a model API key.
API_ACCESS_TOKEN=
# Student starter preset: Beijing Qwen3.7-Flash, thinking explicitly disabled.
# Keep your model's "free quota only" switch ON in the Bailian console.
LLM_PROVIDER=qwen
# Supported Beijing legacy URL. A workspace-specific Beijing URL may replace it.
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash
# json_schema is stricter; use json_object only if the provider lacks strict outputs.
LLM_JSON_MODE=json_schema
LLM_TOKEN_FIELD=max_completion_tokens
LLM_MAX_OUTPUT_TOKENS=1280
SCORE_TIMEOUT_MS=45000
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_SCORES=2
